include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# blaspp++
if (NOT blaspp_DIR)
    set(blaspp_DIR @blaspp_DIR@)
endif()
find_dependency(blaspp)

# lapack++
if (NOT lapackpp_DIR)
    set(lapackpp_DIR @lapackpp_DIR@)
endif()
find_dependency(lapackpp)

include(Proj)
